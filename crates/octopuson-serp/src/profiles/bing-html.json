{
  "id": "bing-html",
  "revision": 2,
  "engine": "bing",
  "mapping": {
    "format": "html",
    "total": [".sb_count"],
    "results": {
      "items": ["#b_results > li.b_algo", "#b_results li.b_algo"],
      "fields": {
        "url": ["h2 a @href", "a.tilk @href", "a @href"],
        "title": ["h2"],
        "snippet": ["div.b_caption p", "p.b_lineclamp2", "p.b_lineclamp3", "p.b_lineclamp4", "p.b_algoSlug", "div.b_caption"],
        "displayed_url": ["cite"],
        "date": ["span.news_dt"],
        "sitelink_titles[]": ["ul.b_vList li a", "div.b_deep h3 a", "div.b_algoDeepLinks a"],
        "sitelink_urls[]": ["ul.b_vList li a @href", "div.b_deep h3 a @href", "div.b_algoDeepLinks a @href"]
      },
      "skip_urls": ["https://www.bing.com/search", "https://www.bing.com/images", "https://www.bing.com/videos", "https://www.bing.com/maps"]
    },
    "features": [
      {
        "kind": "ads-top",
        "container": ["#b_results > li.b_ad:not(.b_adBottom)", "#b_pole li.b_ad"],
        "items": ["li", "div.sb_add"],
        "fields": { "text": ["h2"], "url": ["h2 a @href", "a @href"] }
      },
      {
        "kind": "ads-bottom",
        "container": ["#b_results > li.b_ad.b_adBottom"],
        "items": ["li", "div.sb_add"],
        "fields": { "text": ["h2"], "url": ["h2 a @href", "a @href"] }
      },
      {
        "kind": "ai-overview",
        "container": ["#b_genserp_container", "#b_results > li.b_ans", "#b_topw > li"],
        "anchors": ["Copilot", "Yapay zeka", "AI-generated"],
        "items": ["a[href^='http']"],
        "fields": { "url": ["@href"], "text": ["::text"] }
      },
      {
        "kind": "featured-snippet",
        "container": ["#b_results > li.b_ans div.b_focusTextLarge", "#b_topw li.b_ans div.qna_body", "#b_results > li.b_ans div.rwrl"],
        "fields": { "text": ["::text"], "url": ["a @href"] }
      },
      {
        "kind": "people-also-ask",
        "container": ["#b_results > li.b_ans", "div.df_alsoAskCard"],
        "anchors": ["People also ask", "İlgili sorular", "Diğer kullanıcılar şunları da sordu", "Kullanıcılar ayrıca soruyor"],
        "items": ["div.df_qntext", "div.b_expandableAnswer div.b_primtxt"],
        "fields": { "text": ["::text"] }
      },
      {
        "kind": "local-pack",
        "container": ["#b_results > li.b_ans", "div.b_localMain"],
        "anchors": ["Places", "Yerler", "Konumlar", "Businesses"],
        "items": ["div.b_scard", "div.lc_content"],
        "fields": { "text": ["h2", "div.lc_content h2", "::text"], "url": ["a @href"] }
      },
      {
        "kind": "videos",
        "container": ["#b_results > li.b_ans", "div.b_vidAns"],
        "anchors": ["Videos", "Videolar"],
        "items": ["div.mc_vtvc", "div.mc_fgvc"],
        "fields": { "text": ["div.mc_vtvc_title", "::text"], "url": ["a @href"] }
      },
      {
        "kind": "images",
        "container": ["#b_results > li.b_ans"],
        "anchors": ["Images", "Görseller", "Resimler"]
      },
      {
        "kind": "top-stories",
        "container": ["#b_results > li.b_ans"],
        "anchors": ["Top stories", "News", "Haberler"],
        "items": ["a.title", "div.na_ccw a"],
        "fields": { "text": ["::text"], "url": ["@href"] }
      },
      {
        "kind": "related-searches",
        "container": ["#brsv3", "div.b_rs", "#b_results > li.b_ans div.b_rs"],
        "items": ["a"],
        "fields": { "text": ["::text"], "url": ["@href"] }
      },
      {
        "kind": "knowledge-panel",
        "container": ["#b_context li.b_entityTP", "#b_context .b_entityTitle", "#b_context li.b_ans"],
        "fields": { "text": [".b_entityTitle", "h2"] }
      }
    ],
    "challenges": [
      { "kind": "captcha", "url_contains": "/turing/captcha" },
      { "kind": "captcha", "selector": "iframe[src*='challenges.cloudflare.com']" },
      { "kind": "captcha", "text_contains": "Please solve the challenge below to continue" },
      { "kind": "captcha", "selector": "#turnstile-widget" },
      { "kind": "captcha", "selector": "input[name='cf-turnstile-response']" },
      { "kind": "consent", "selector": "#bnp_container #bnp_btn_accept" }
    ],
    "post": ["bing-redirect"]
  }
}
