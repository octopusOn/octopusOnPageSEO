# /etc/octopuson/platform.env: settings of the web GEO-SEO Platform (deploy/platform), root 600.
# The unit sets the addresses, the port and the data folder itself; see docs/platform.md,
# "Web server settings". Back up PLATFORM_MASTER_KEY: without it the sealed account tokens and
# API keys in /var/lib/octopuson/platform cannot be opened.

# 32 random bytes, base64: openssl rand -base64 32
PLATFORM_MASTER_KEY=

# Search Console and Analytics: a Google OAuth client of type "Web application" whose redirect URI
# is https://app.octopuson.com/auth/google/callback. Both or neither.
#PLATFORM_GOOGLE_CLIENT_ID=
#PLATFORM_GOOGLE_CLIENT_SECRET=

# Report e-mails over TLS: smtps://user:password@host:465 or smtp://user:password@host:587?tls=required.
# Both or neither.
#PLATFORM_SMTP_URL=
#PLATFORM_MAIL_FROM=OctopusOn SEO <rapor@octopuson.com>

# Report PDFs need Chrome or Chromium; set this when it is not on the usual paths.
#OCTOPUSSEO_CHROME_PATH=/usr/bin/chromium

# Log level (error, warn, info, debug).
#RUST_LOG=info
