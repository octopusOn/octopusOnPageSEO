# api.octopuson.com: the credits gateway (apps/gateway), run from the repository's TypeScript.
# Installed as /etc/systemd/system/octopuson-gateway.service; see docs/cloud.md, "Deploying".
[Unit]
Description=OctopusOn SEO credits gateway (api.octopuson.com, apps/gateway)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=octopuson
Group=octopuson
WorkingDirectory=/home/octopuson/octopusOnPageSEO/apps/gateway
# DATABASE_URL and OCTOPUS_MASTER_KEY, shared with the portal.
EnvironmentFile=/etc/octopuson/cloud.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=TRUST_PROXY=1
Environment=PORTAL_URL=https://my.octopuson.com
ExecStart=/opt/node-v22.23.3-linux-x64/bin/node src/main.ts
# On SIGTERM the gateway waits up to 30 s for requests in flight.
TimeoutStopSec=40
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
