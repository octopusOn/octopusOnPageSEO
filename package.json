{
  "name": "seonexus",
  "private": true,
  "description": "Frontend workspace: desktop UI and the octopusSEO website.",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "desktop": "pnpm --filter @seonexus/desktop tauri dev",
    "desktop:build": "pnpm --filter @seonexus/desktop tauri build",
    "check": "pnpm --filter @seonexus/desktop check",
    "web": "pnpm --filter @octopusseo/web dev",
    "web:build": "pnpm --filter @octopusseo/web build",
    "web:downloads": "pnpm --filter @octopusseo/web downloads",
    "spider": "pnpm --filter @octopusseo/spider tauri dev",
    "spider:build": "pnpm --filter @octopusseo/spider tauri build",
    "spider:dev": "pnpm --filter @octopusseo/spider dev",
    "finder": "pnpm --filter @octopusseo/finder tauri dev",
    "finder:build": "pnpm --filter @octopusseo/finder tauri build",
    "finder:dev": "pnpm --filter @octopusseo/finder dev",
    "keywords": "pnpm --filter @octopusseo/keywords tauri dev",
    "keywords:build": "pnpm --filter @octopusseo/keywords tauri build",
    "keywords:dev": "pnpm --filter @octopusseo/keywords dev",
    "serp": "pnpm --filter @octopusseo/serp tauri dev",
    "serp:build": "pnpm --filter @octopusseo/serp tauri build",
    "serp:dev": "pnpm --filter @octopusseo/serp dev",
    "cms": "pnpm --filter @octopusseo/cms serve",
    "cms:build": "pnpm --filter @octopusseo/cms build",
    "release": "node scripts/release.mjs"
  }
}
