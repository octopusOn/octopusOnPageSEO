{
  "name": "octopuson-seo",
  "private": true,
  "description": "Frontend workspace: desktop UI and the octopusSEO website.",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "desktop": "pnpm --filter @octopusseo/log-analyser tauri dev",
    "desktop:build": "pnpm --filter @octopusseo/log-analyser tauri build",
    "check": "pnpm --filter @octopusseo/log-analyser check",
    "web": "pnpm --filter @octopusseo/web dev",
    "web:build": "pnpm --filter @octopusseo/web build",
    "web:downloads": "pnpm --filter @octopusseo/web downloads",
    "spider": "pnpm --filter @octopusseo/seo-crawler tauri dev",
    "spider:build": "pnpm --filter @octopusseo/seo-crawler tauri build",
    "spider:dev": "pnpm --filter @octopusseo/seo-crawler dev",
    "finder": "pnpm --filter @octopusseo/index-checker tauri dev",
    "finder:build": "pnpm --filter @octopusseo/index-checker tauri build",
    "finder:dev": "pnpm --filter @octopusseo/index-checker dev",
    "keywords": "pnpm --filter @octopusseo/seo-keyword-research tauri dev",
    "keywords:build": "pnpm --filter @octopusseo/seo-keyword-research tauri build",
    "keywords:dev": "pnpm --filter @octopusseo/seo-keyword-research dev",
    "serp": "pnpm --filter @octopusseo/serp-checker tauri dev",
    "serp:build": "pnpm --filter @octopusseo/serp-checker tauri build",
    "serp:dev": "pnpm --filter @octopusseo/serp-checker dev",
    "platform": "pnpm --filter @octopusseo/geo-seo-platform tauri dev",
    "platform:build": "pnpm --filter @octopusseo/geo-seo-platform tauri build",
    "platform:dev": "pnpm --filter @octopusseo/geo-seo-platform dev",
    "cms": "pnpm --filter @octopusseo/cms serve",
    "cms:build": "pnpm --filter @octopusseo/cms build",
    "release": "node scripts/release.mjs"
  }
}
