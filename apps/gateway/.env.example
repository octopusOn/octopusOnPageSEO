# api.octopuson.com — copy to .env.local for development.
DATABASE_URL=postgres://octopus:octopus@localhost:5432/octopus
# The portal's key (openssl rand -base64 32): opens our provider credentials and device tokens.
OCTOPUS_MASTER_KEY=
PORTAL_URL=http://localhost:3030
# The loopback by default; 0.0.0.0 only when nothing else stands in front.
HOST=127.0.0.1
PORT=8787
# 1 behind nginx: read the client address from X-Forwarded-For.
TRUST_PROXY=0
CONNECTOR_REFRESH_SECONDS=10
