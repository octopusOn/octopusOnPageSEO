{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OctopusOn SEO Crawler",
  "mainBinaryName": "octopusseo-spider",
  "version": "0.1.0",
  "identifier": "com.octopusseo.spider",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OctopusOn SEO Crawler",
        "width": 1440,
        "height": 940,
        "minWidth": 1040,
        "minHeight": 660,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "backgroundColor": "#0a2632",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "octopusSEO",
    "copyright": "\u00a9 2026 octopusSEO",
    "homepage": "https://octopuson.com",
    "category": "DeveloperTool",
    "shortDescription": "Technical SEO crawler and site audit",
    "longDescription": "Crawl websites, inspect page metadata, find technical SEO issues and export results.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}