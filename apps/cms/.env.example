APP_NAME="OctopusOn SEO İçerik"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CMS_MEDIA_DISK=public
QUEUE_CONNECTION=database

# The API rate limiter writes to the cache on every request; keep it out of SQLite.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- octopusSEO website (apps/web) ---------------------------------------------------------
# Public address of the website, for "view on site" and preview links.
CMS_WEB_URL=http://localhost:3000
# The account site (credits, API connections) the website's API and credit blocks link to.
CMS_ACCOUNT_URL=https://my.octopuson.com
# The website's revalidation endpoint; the admin posts the `cms` cache tag there after every
# change. Empty: the site picks changes up within an hour. Both apps share the secret.
CMS_REVALIDATE_URL=http://localhost:3000/api/revalidate
CMS_REVALIDATE_SECRET=
# Signs draft preview links and lets the website read drafts (same value in apps/web).
CMS_PREVIEW_SECRET=

# First admin account, created by `php artisan db:seed` (or `php artisan cms:admin`). With an
# empty password the seeder generates one and prints it once.
CMS_ADMIN_NAME=Admin
CMS_ADMIN_EMAIL=admin@octopuson.test
CMS_ADMIN_PASSWORD=
