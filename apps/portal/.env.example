# my.octopuson.com — copy to .env.local for development.
DATABASE_URL=postgres://octopus:octopus@localhost:5432/octopus
# 32 random bytes in base64 (openssl rand -base64 32); the same key as the gateway.
OCTOPUS_MASTER_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3030
# The CMS (apps/cms): the portal's languages and its legal texts.
CMS_API_URL=http://localhost:8000
# smtp://user:password@smtp.example.com:587 — without it, mails are printed to the console.
SMTP_URL=
MAIL_FROM=OctopusOn SEO <hesap@octopuson.com>
# Times in tables (default Europe/Istanbul).
PORTAL_TIME_ZONE=Europe/Istanbul

# Payments: iyzico or paytr. Without them the credits page says payments open soon.
PAYMENT_PROVIDER=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# https://sandbox-api.iyzipay.com (default) or https://api.iyzipay.com
IYZICO_BASE_URL=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 (default) for test payments, 0 when live.
PAYTR_TEST_MODE=1

# e-Arşiv / e-Fatura through Paraşüt (client id and secret from destek@parasut.com).
# Without them invoices are left to the accountant (CSV export in the admin panel).
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
# The cash or bank account card payments are booked to.
PARASUT_ACCOUNT_ID=

# The seller in the legal texts; LEGAL_APPROVED=1 once a lawyer has reviewed them.
COMPANY_TITLE=
COMPANY_ADDRESS=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NUMBER=
COMPANY_MERSIS=
COMPANY_EMAIL=destek@octopuson.com
COMPANY_PHONE=
COMPANY_KEP=
LEGAL_APPROVED=0
# The language whose legal text is binding; the others are shown as translations (tr unless set).
LEGAL_LANGUAGE=
