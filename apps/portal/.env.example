# my.octopuson.com — copy to .env.local for development.
DATABASE_URL=postgres://octopus:octopus@localhost:5432/octopus
# 32 random bytes in base64 (openssl rand -base64 32); the same key as the gateway.
OCTOPUS_MASTER_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3030
# The CMS (apps/cms): the portal's languages and its legal texts.
CMS_API_URL=http://localhost:8000
# smtp://user:password@smtp.example.com:587 — without it, mails are printed to the console.
SMTP_URL=
MAIL_FROM=OctopusOn SEO <hesap@octopuson.com>
# "off" lets new accounts in without confirming their e-mail address (while no SMTP server is set
# up, for example); empty asks for the confirmation e-mail.
EMAIL_VERIFICATION=
# Times in tables (default Europe/Istanbul).
PORTAL_TIME_ZONE=Europe/Istanbul

# Payments: iyzico, paytr or transfer. Without them the credits page says payments open soon.
PAYMENT_PROVIDER=
# transfer: buyers get these bank details (and/or PAYONEER_LINK) and the order's reference; an admin marks the order
# paid under Admin → Orders when the money arrives. TRANSFER_CURRENCY is the account's: TRY
# (default) or USD (the order's lira at its rate).
TRANSFER_BANK=
TRANSFER_HOLDER=
TRANSFER_IBAN=
TRANSFER_CURRENCY=
# A Payoneer payment link (Payoneer → Receive → Request a payment), shown beside the bank or
# alone: buyers pay the order's dollars by card, bank or PayPal; mark it "Payoneer payment received".
PAYONEER_LINK=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# https://sandbox-api.iyzipay.com (default) or https://api.iyzipay.com
IYZICO_BASE_URL=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 (default) for test payments, 0 when live.
PAYTR_TEST_MODE=1

# e-Arşiv / e-Fatura through Paraşüt (client id and secret from destek@parasut.com).
# Without them invoices are left to the accountant (CSV export in the admin panel).
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
# The cash or bank account card payments are booked to.
PARASUT_ACCOUNT_ID=

# The seller in the legal texts; LEGAL_APPROVED=1 once a lawyer has reviewed them.
COMPANY_TITLE=
COMPANY_ADDRESS=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NUMBER=
COMPANY_MERSIS=
COMPANY_EMAIL=destek@octopuson.com
COMPANY_PHONE=
COMPANY_KEP=
LEGAL_APPROVED=0
# The language whose legal text is binding; the others are shown as translations (tr unless set).
LEGAL_LANGUAGE=
# Web applications that may sign in with the account (one-click, PKCE): exact return addresses,
# comma separated. The GEO-SEO Platform: https://app.octopuson.com/auth/callback
CONNECT_WEB_REDIRECTS=
