{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OctopusOn SEO Keyword Research",
  "mainBinaryName": "octopusseo-keyword-miner",
  "version": "0.1.0",
  "identifier": "com.octopusseo.keyword-miner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OctopusOn SEO Keyword Research",
        "width": 1440,
        "height": 940,
        "minWidth": 1040,
        "minHeight": 660,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "backgroundColor": "#062a22",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "octopusSEO",
    "copyright": "© 2026 octopusSEO",
    "homepage": "https://octopuson.com",
    "category": "DeveloperTool",
    "shortDescription": "Keyword discovery and clustering",
    "longDescription": "Discover keywords from seeds, competitors and your own Google data, group them into clusters one page can target, and map the clusters to your site.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
