# Public address of the site (canonical URLs, sitemap, Open Graph).
OCTOPUSSEO_SITE_URL=https://octopuson.com
# GitHub repository whose releases are offered for download and starred from the header
# (default octopusOn/octopusOnPageSEO). Every download link leads to its GitHub releases.
OCTOPUSSEO_GITHUB_REPO=
# Set to 1 to offer the files collected with `pnpm web:downloads` when GitHub has no release.
OCTOPUSSEO_LOCAL_DOWNLOADS=
# Optional: raises the GitHub API rate limit (read-only token, no scopes needed).
GITHUB_TOKEN=
# Optional contact address shown in the footer.
OCTOPUSSEO_CONTACT_EMAIL=

# --- Content (apps/cms) ---------------------------------------------------------------------
# Base URL of the CMS API. Pages, menus and languages come from it.
CMS_API_URL=http://localhost:8000
# Shared with the CMS (same name there): it posts content changes to /api/revalidate with it.
CMS_REVALIDATE_SECRET=
# Shared with the CMS: verifies its preview links and lets this site read drafts.
CMS_PREVIEW_SECRET=
