# Public address of the site (canonical URLs, sitemap, Open Graph).
OCTOPUSSEO_SITE_URL=https://octopusseo.com
# GitHub repository whose releases are offered for download (default
# sabri-kocabas/octopusseo-log-analyser). `none` disables GitHub: the site then offers the files
# collected with `pnpm web:downloads`, or says releases are coming soon.
OCTOPUSSEO_GITHUB_REPO=
# Optional: raises the GitHub API rate limit (read-only token, no scopes needed).
GITHUB_TOKEN=
# Optional contact address shown in the footer.
OCTOPUSSEO_CONTACT_EMAIL=
